{
  "name": "ziqu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "extract:chars": "node scripts/extract-textbook-character-bank.mjs",
    "extract:garden": "node scripts/extract-garden-dictation.mjs",
    "rebuild:catalog": "node scripts/rebuild-catalog-from-materials.mjs",
    "rebuild:data": "node scripts/rebuild-catalog-from-materials.mjs",
    "mastery:seed": "node scripts/seed-character-mastery.mjs",
    "mastery:report": "node scripts/report-character-mastery.mjs",
    "prompts:audit": "node scripts/audit-dictation-prompts.mjs",
    "prompts:coverage": "node scripts/audit-practice-coverage.mjs",
    "sentences:audit": "node --experimental-strip-types --experimental-transform-types scripts/audit-sentence-hints.mjs",
    "sentences:fetch": "node --experimental-strip-types --experimental-transform-types scripts/fetch-sentence-candidates.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "pinyin-pro": "^3.28.1",
    "typescript": "^5.7.3"
  }
}
